#!/bin/bash
#SBATCH --job-name=rabbitfish-espdl
#SBATCH --time=0-00:45:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32g
#SBATCH --gres=gpu:1
#SBATCH --output=logs/export_%j.out
#SBATCH --error=logs/export_%j.err

# ESP32-S3 export with scripts/esp32_export.py: ONNX -> esp-ppq w8a8 .espdl, plus float vs
# simulated-int8 scores on val. Blockwise reconstruction takes ~30 min on an H100.
# Arguments go straight to the script:
#   sbatch -A <account> -p <gpu-partition> hpc/export_esp32.job \
#       --run yolo26n-b8-i320 --cls-clamp 10 --box16 --blockwise --device cuda

set -euo pipefail
source "$(dirname "$0")/env.sh" espdl
python scripts/esp32_export.py "$@"
